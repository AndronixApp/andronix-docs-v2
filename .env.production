# Public build settings, committed on purpose (nothing secret goes here; .env and .env*.local stay ignored).
# OpenPanel "web" client on events.andronix.app (public id, shared with andronix.app). Next.js reads
# it at build time; an OPENPANEL_WEB_CLIENT_ID set in the environment overrides it.
OPENPANEL_WEB_CLIENT_ID=b798ebe6-278f-4cd0-beb3-8759abd175f1

# Firebase Auth helper domain for /chat sign-in: the Worker proxies /__/auth/* to firebaseapp.com, so Google's
# prompt names andronix.app, not firebaseapp.com. Needs https://docs.andronix.app/__/auth/handler on the web OAuth client.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=docs.andronix.app

# Chat entry points (docs home "Ask the assistant" card, selection ask). Public since 2026-11-26.
NEXT_PUBLIC_CHAT_ENTRY=1
