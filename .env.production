# Public build settings, committed on purpose (nothing secret goes here; .env and .env*.local stay ignored).
# OpenPanel "web" client on events.andronix.app (public id, shared with andronix.app). Next.js reads
# it at build time; an OPENPANEL_WEB_CLIENT_ID set in the environment overrides it.
OPENPANEL_WEB_CLIENT_ID=b798ebe6-278f-4cd0-beb3-8759abd175f1
